# Copy to .env and edit. Never commit .env. Placeholders only; no real secrets belong here.

# Required: long random string used to sign session cookies. Generate with scripts/make_secret.sh
BILLFLOW_SESSION_SECRET=replace-with-output-of-make_secret

# First owner account, created on first startup only if no user exists yet.
BILLFLOW_ORG_NAME="Demo CA Firm"
BILLFLOW_ADMIN_EMAIL=owner@example.com
BILLFLOW_ADMIN_PASSWORD=replace-with-12-plus-character-password

# Storage locations (defaults: ./data/billflow.sqlite3 and ./uploads)
BILLFLOW_DATABASE_PATH=
BILLFLOW_UPLOAD_DIR=

# Upload limits
BILLFLOW_MAX_UPLOAD_BYTES=10485760

# Sessions and cookies. Set BILLFLOW_COOKIE_SECURE=true only when served over HTTPS.
BILLFLOW_SESSION_MAX_AGE=28800
BILLFLOW_COOKIE_SECURE=false

# Optional OCR. Leave empty to use the tesseract found on PATH.
BILLFLOW_TESSERACT_CMD=

# Validation tolerance for rounding differences, in rupees
BILLFLOW_TOLERANCE_RUPEES=1.00

# Password hashing cost (PBKDF2-SHA256 iterations). Default is fine for a laptop.
BILLFLOW_PBKDF2_ITERATIONS=390000

# AI provider: none in this MVP. No external AI API key is required or read.
